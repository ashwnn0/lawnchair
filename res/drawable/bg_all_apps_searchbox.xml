<?xml version="1.0" encoding="utf-8"?>
<!-- Aqua Glass search field: translucent aqua fill with a subtle glass edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:angle="90"
        android:startColor="#DDF8FEFF"
        android:centerColor="#C8D8F5F8"
        android:endColor="#AFC1EAF0" />
    <stroke android:width="1dp" android:color="#DFFFFFFF" />
</shape>